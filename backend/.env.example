# Copia este archivo a .env en el servidor — compose lo carga con env_file.
#   cp .env.example .env
# .env.example NO se aplica solo; sin .env faltan variables en trackrate-api.

DATABASE_URL=postgresql+psycopg://trackrate:trackrate@trackrate-postgres:5432/trackrate
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

MINIO_ENDPOINT=trackrate-minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_PUBLIC_URL=http://100.126.35.7:9000

# En el stack unificado la API resuelve MusicBrainz por nombre de servicio Docker.
# Solo necesitas cambiar esto si corres la API fuera de compose:
MUSICBRAINZ_WS_URL=http://musicbrainz:5000/ws/2
MUSICBRAINZ_DATABASE_URL=postgresql+psycopg://musicbrainz:musicbrainz@db:5432/musicbrainz_db
MUSICBRAINZ_USER_AGENT=TrackRate/1.0 (dev@trackrate.local)
COVER_ART_ARCHIVE_URL=https://coverartarchive.org

# Sonic — búsqueda rápida con typos + autocomplete
SONIC_ENABLED=true
SONIC_HOST=host.docker.internal
SONIC_PORT=1491
SONIC_PASSWORD=TrackRateSonicDev
SONIC_COLLECTION=catalog
SONIC_FALLBACK_SQL=true
SONIC_TIMEOUT_SECONDS=60
SONIC_QUERY_TIMEOUT_SECONDS=8
SONIC_QUERY_READ_TIMEOUT_SECONDS=120
SONIC_PROBE_TIMEOUT_SECONDS=5

CORS_ORIGINS=*
